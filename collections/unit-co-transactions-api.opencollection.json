{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unit Accounts Transactions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get List Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.s.unit.sh/transactions",
            "params": [
              {
                "name": "page[limit]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[offset]",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Paging is available only when filtering by customer id or account id."
        },
        {
          "info": {
            "name": "Get Transaction by Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.s.unit.sh/accounts/:accountId/transactions/:transactionId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              },
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Transaction by Id"
        },
        {
          "info": {
            "name": "Update Transaction",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.s.unit.sh/accounts/:accountId/transactions/:transactionId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              },
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Transaction"
        }
      ]
    }
  ],
  "bundled": true
}