    {
      "name": "Accounts",
      "item": [
        {
          "name": "Get List Accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "Lists deposit and credit accounts."
          }
        },
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/vnd.api+json" }],
            "body": { "mode": "raw", "raw": "{\n  \"data\": {\n    \"type\": \"depositAccount\",\n    \"attributes\": {\n      \"depositProduct\": \"checking\",\n      \"tags\": { \"purpose\": \"checking\" },\n      \"idempotencyKey\": \"3a1a33be-4e12-4603-9ed0-820922389fb8\"\n    },\n    \"relationships\": {\n      \"customer\": { \"data\": { \"type\": \"customer\", \"id\": \"45555\" } }\n    }\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "Creates a deposit or credit account for a customer."
          }
        },
        {
          "name": "Get Account by Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/accounts/:accountId", "host": ["{{baseUrl}}"], "path": ["accounts", ":accountId"], "variable": [{ "key": "accountId", "value": "" }] },
            "description": "Retrieves an account by ID."
          }
        },
        {
          "name": "Freeze Account by Id",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/accounts/:accountId/freeze", "host": ["{{baseUrl}}"], "path": ["accounts", ":accountId", "freeze"], "variable": [{ "key": "accountId", "value": "" }] },
            "description": "Freezes an account."
          }
        },
        {
          "name": "Close an Account by Id",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/accounts/:accountId/close", "host": ["{{baseUrl}}"], "path": ["accounts", ":accountId", "close"], "variable": [{ "key": "accountId", "value": "" }] },
            "description": "Closes an account."
          }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "Get List of Cards",
          "request": {
            "method": "GET",
