          "name": "Get Events List",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/events?page[limit]=20&filter[since]=2026-06-01T00:00:00.000Z", "host": ["{{baseUrl}}"], "path": ["events"], "query": [{ "key": "page[limit]", "value": "20" }, { "key": "filter[since]", "value": "2026-06-01T00:00:00.000Z" }] },
            "description": "Lists events going back up to 90 days."
