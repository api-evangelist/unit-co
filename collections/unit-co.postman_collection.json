{
  "info": {
    "name": "Unit API",
    "description": "Unit is a Banking-as-a-Service (BaaS) platform. This collection covers Applications, Customers, Accounts, Cards, Authorizations, Payments, Counterparties, Checks, Transactions, Statements, Tax Forms, Events, Webhooks, Risk/Fraud, Credit/Repayments, Fees/Rewards, and API Tokens. All requests use the JSON:API media type (application/vnd.api+json) and a Bearer token. Sandbox base URL: https://api.s.unit.sh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{bearerToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.s.unit.sh", "type": "string" },
    { "key": "bearerToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Applications",
      "item": [
        {
          "name": "Get List Application",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/applications", "host": ["{{baseUrl}}"], "path": ["applications"] },
            "description": "Lists individual and business applications with filtering, sorting, and paging."
          }
        },
        {
          "name": "Create Application",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/vnd.api+json" }],
            "body": { "mode": "raw", "raw": "{\n  \"data\": {\n    \"type\": \"individualApplication\",\n    \"attributes\": {\n      \"ssn\": \"123456789\",\n      \"fullName\": { \"first\": \"John\", \"last\": \"Kenn\" },\n      \"dateOfBirth\": \"1989-02-01\",\n      \"address\": { \"street\": \"123 Main St\", \"city\": \"San Francisco\", \"state\": \"CA\", \"postalCode\": \"94205\", \"country\": \"US\" },\n      \"email\": \"jone.doe@unit-finance.com\",\n      \"phone\": { \"countryCode\": \"1\", \"number\": \"5555555555\" },\n      \"occupation\": \"ArchitectOrEngineer\",\n      \"annualIncome\": \"UpTo10k\",\n      \"sourceOfIncome\": \"EmploymentOrPayrollIncome\"\n    }\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/applications", "host": ["{{baseUrl}}"], "path": ["applications"] },
            "description": "Creates an individualApplication or businessApplication."
          }
        },
        {
          "name": "Get Application by Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/applications/:applicationId", "host": ["{{baseUrl}}"], "path": ["applications", ":applicationId"], "variable": [{ "key": "applicationId", "value": "" }] },
            "description": "Retrieves an application by ID."
          }
        },
        {
          "name": "Cancel Application by Id",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/applications/:applicationId/cancel", "host": ["{{baseUrl}}"], "path": ["applications", ":applicationId", "cancel"], "variable": [{ "key": "applicationId", "value": "" }] },
            "description": "Cancels a pending application."
          }
        }
      ]
    },
