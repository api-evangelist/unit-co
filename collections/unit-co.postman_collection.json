            "description": "Approves a real-time authorization request."
          }
        },
        {
          "name": "Decline Authorization Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/vnd.api+json" }],
            "body": { "mode": "raw", "raw": "{\n  \"data\": { \"type\": \"declineAuthorizationRequest\", \"attributes\": { \"reason\": \"InsufficientFunds\" } }\n}" },
            "url": { "raw": "{{baseUrl}}/authorization-requests/:authorizationId/decline", "host": ["{{baseUrl}}"], "path": ["authorization-requests", ":authorizationId", "decline"], "variable": [{ "key": "authorizationId", "value": "" }] },
            "description": "Declines a real-time authorization request with a reason."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get List Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "description": "Lists payments."
          }
        },
        {
          "name": "Create a Book Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/vnd.api+json" }],
            "body": { "mode": "raw", "raw": "{\n  \"data\": {\n    \"type\": \"bookPayment\",\n    \"attributes\": { \"amount\": 10000, \"description\": \"Book payment\" },\n    \"relationships\": {\n      \"account\": { \"data\": { \"type\": \"depositAccount\", \"id\": \"10001\" } },\n      \"counterpartyAccount\": { \"data\": { \"type\": \"depositAccount\", \"id\": \"10002\" } }\n    }\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "description": "Creates an internal, instant book payment."
          }
        },
        {
          "name": "Create an ACH Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/vnd.api+json" }],
            "body": { "mode": "raw", "raw": "{\n  \"data\": {\n    \"type\": \"achPayment\",\n    \"attributes\": { \"amount\": 5000, \"direction\": \"Credit\", \"description\": \"ACH payment\" },\n    \"relationships\": {\n      \"account\": { \"data\": { \"type\": \"depositAccount\", \"id\": \"10001\" } },\n      \"counterparty\": { \"data\": { \"type\": \"counterparty\", \"id\": \"20001\" } }\n    }\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "description": "Creates an ACH debit or credit payment."
          }
        },
        {
          "name": "Cancel a Payment by Id",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/payments/:paymentId/cancel", "host": ["{{baseUrl}}"], "path": ["payments", ":paymentId", "cancel"], "variable": [{ "key": "paymentId", "value": "" }] },
            "description": "Cancels a pending payment."
          }
        }
      ]
    },
