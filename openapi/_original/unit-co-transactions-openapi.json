{
  "openapi": "3.0.2",
  "info": {
    "title": "Unit Transactions API",
    "description": "List and retrieve account transactions across all payment and card activity.",
    "version": "0.4.0"
  },
  "servers": [
    {
      "url": "https://api.s.unit.sh"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/transactions": {
      "$ref": "./schemas/transaction/transactionPaths.json#/listTransactions"
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}